    {
      "parameters": {
        "jsCode": "\nconst stories = $input.all().map(item => item.json);\n\nconst validStories = stories\n  .filter(story => story && story.title && story.url)\n  .map(story => ({\n    title: story.title,\n    url: story.url,\n    author: story.by,\n    score: story.score || 0,\n    publishedAt: new Date(story.time * 1000).toISOString()\n  }));\n\nvalidStories.sort((a, b) => b.score - a.score);\n\nreturn validStories.map(story => ({\n  json: story\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        112
      ],
      "id": "cdc0f45f-2f1a-4732-a725-956a1efe23f2",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "\nconst stories = $input.all().map(item => item.json);\n\nconst filtered = stories.filter(story => story.score > 100);\n\nconst message = filtered.map((story, index) =>\n  `🔥 ${index + 1}. ${story.title}\\n` +\n  `Score: ${story.score}\\n` +\n  `Author: ${story.author}\\n` +\n  `URL: ${story.url}`\n).join('\\n\\n');\n\nreturn [{\n  json: {\n    content: `Hacker News Top Stories\\n\\n${message}`\n  }\n}];\n"
      },
